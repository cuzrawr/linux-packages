[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = usr/lib/gdk-pixbuf-2.0/2.10.0/loaders/*.so
Target = usr/bin/gdk-pixbuf-query-loaders

[Action]
Description = Updating GDK-Pixbuf loader cache...
When = PostTransaction
Depends = gdk-pixbuf2-noglycin
Exec = /usr/bin/gdk-pixbuf-query-loaders --update-cache
